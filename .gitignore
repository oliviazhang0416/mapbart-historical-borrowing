# macOS / R session cruft
.DS_Store
.Rhistory
.Rapp.history
.Rproj.user/
.Rproj.user
*.Rproj.user

# ---------------------------------------------------------------------------
# Regenerable model output. Directory structure is kept via .gitkeep so that
# run_all.R has somewhere to write on a fresh clone.
# ---------------------------------------------------------------------------
**/res/*
!**/res/.gitkeep

**/inserts/*
!**/inserts/.gitkeep

# ---------------------------------------------------------------------------
# Simulated datasets. Rebuild with data_gen_p10.R in each sim project.
# ---------------------------------------------------------------------------
lrcbart-sim-gaussian/data/*
!lrcbart-sim-gaussian/data/.gitkeep
lrcbart-sim-gaussian-single-arm/data/*
!lrcbart-sim-gaussian-single-arm/data/.gitkeep
lrcbart-sim-survival/data/*
!lrcbart-sim-survival/data/.gitkeep
lrcbart-sim-survival-single-arm/data/*
!lrcbart-sim-survival-single-arm/data/.gitkeep

# ---------------------------------------------------------------------------
# Patient-level inputs. NEVER publish: this repository is public.
# ---------------------------------------------------------------------------
lrcbart-case-study-mm/private_data/

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# ---------------------------------------------------------------------------
# HELD: per-source cleaned cohorts carry 25 columns (iss/riss/ecog, full
# cytogenetics, heavy/light chain, best_response) well beyond the columns the
# analysis uses. Matched by pattern, not by name, so a cohort renumbering
# (n253 -> n200) cannot silently publish them.
#
# The merged_* analysis sets are the 18-column files already published on
# main and are NOT held.
# ---------------------------------------------------------------------------
lrcbart-case-study-mm/data_cleaned/ucmm_cleaned_*.RData
lrcbart-case-study-mm/data_cleaned/elokrd_cleaned_*.RData

# Python build artifacts
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Internal migration plans: kept locally, not published.
# ---------------------------------------------------------------------------
/*_MIGRATION_PLAN.md
